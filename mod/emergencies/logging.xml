<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- A timber trailer has overturned and its logs lie across the road. The Emergency Pack runs it: pager, map marker, progress, hints and pay. It starts on a road lane
     (spline); our first step moves it to a random spot on the road network. The logs are the job (Z): every one has to be clear of the road, and the owner's crew sees to
     the trailer a while after the job is done. Pay: our amount (Config.lua, WRECKS). -->
<scenario description="rse_ep_logging_description" postMessage="rse_ep_doneWreck" startStrategy="spline"
          engagementDistance="10" rewardDifficultyCategory="1" rewardTeeSizeCategory="1" width="12" height="6" length="16">
    <checkpoints>
        <checkpoint hint="rse_ep_hint_arrive" actionClass="FS25_RoadsideEmergencies.RseStepArrive">
            <action range="25" wreck="logging" emergency="logging"/>
        </checkpoint>
        <checkpoint hint="rse_logs_hint" actionClass="FS25_RoadsideEmergencies.RseStepLogs">
            <action/>
        </checkpoint>
    </checkpoints>
</scenario>
