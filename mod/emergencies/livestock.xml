<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- A livestock trailer has overturned: dead animals in the road, loose ones wandering off. Two parts, the animals and the trailer, in any order. The Emergency Pack runs it: pager, map marker, progress, hints and pay. It starts on a road lane (spline); our first step
     moves it to a random spot on the road network. Pay: our amount for each part done (Config.lua, WRECKS), and a bonus for both. -->
<scenario description="rse_ep_livestock_description" postMessage="rse_ep_doneWreck" startStrategy="spline"
          engagementDistance="10" rewardDifficultyCategory="1" rewardTeeSizeCategory="1" width="12" height="6" length="16">
    <checkpoints>
        <checkpoint hint="rse_ep_hint_arrive" actionClass="FS25_RoadsideEmergencies.RseStepArrive">
            <action range="25" wreck="livestock" emergency="livestock"/>
        </checkpoint>
        <checkpoint hint="rse_crash_hint" actionClass="FS25_RoadsideEmergencies.RseStepCrash">
            <action/>
        </checkpoint>
    </checkpoints>
</scenario>
